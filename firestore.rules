rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwnerUid() {
      return signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.createdByUid == request.auth.uid ||
        resource.data.createdByUserId == request.auth.uid
      );
    }
    function isNewOwnerUid() {
      return signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.createdByUid == request.auth.uid ||
        request.resource.data.createdByUserId == request.auth.uid
      );
    }
    function isChatParticipant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }
    function isNewChatParticipant() {
      return signedIn() && request.auth.uid in request.resource.data.participants;
    }

    match /properties/{propertyId} {
      allow read: if resource.data.status == 'published' || isOwnerUid();
      allow create: if isNewOwnerUid();
      allow update, delete: if isOwnerUid();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      // Current app uses the authenticated UID as the company document id.
      allow create, update, delete: if signedIn() && request.auth.uid == companyId;
    }

    match /saves/{saveId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if isChatParticipant();
      allow create: if isNewChatParticipant();
      allow update: if isChatParticipant() && request.auth.uid in request.resource.data.participants;
      allow delete: if isChatParticipant();

      match /messages/{messageId} {
        allow read: if isChatParticipant();
        allow create: if isChatParticipant() && request.resource.data.senderId != null;
        allow update, delete: if isChatParticipant();
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      // Notifications are created by the client app. Sender must be the authenticated account.
      allow create: if signedIn() && (
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.senderUserUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if signedIn() && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if signedIn() && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    match /anonymous_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
